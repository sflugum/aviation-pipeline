# --------------------------------
# Bronze Layer (MySQL)
# --------------------------------
BRONZE_DB_HOST=mysql-bronze
BRONZE_DB_NAME=your_mysql_db
BRONZE_DB_USER=your_mysql_user
BRONZE_DB_PASSWORD=your_mysql_password
BRONZE_DB_ROOT_PASSWORD=your_root_password

# --------------------------------
# Gold Layer (PostgreSQL)
# --------------------------------
GOLD_DB_HOST=postgres-gold
GOLD_DB_NAME=your_postgres_db
GOLD_DB_USER=your_postgres_user
GOLD_DB_PASSWORD=your_postgres_password